# Optional. `docker compose up` works without a .env file — every value below has a default
# in docker-compose.yml. Copy to .env only if you need to change something.

# Ports on your machine
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432

# Database
POSTGRES_USER=crvr
POSTGRES_PASSWORD=crvr
POSTGRES_DB=crvr

# Auth — the default secret is for local development only
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_MINUTES=480

# Create the demo accounts (one per role) on startup
SEED_DEMO_USERS=true

# Windows / WSL: set both to true if code changes are not picked up automatically
WATCHFILES_FORCE_POLLING=false
CHOKIDAR_USEPOLLING=false
