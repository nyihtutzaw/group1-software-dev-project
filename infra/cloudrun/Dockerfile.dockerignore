# Used by `docker build -f infra/cloudrun/Dockerfile .` (BuildKit reads <Dockerfile>.dockerignore).
# Allow-list: only what the production image needs.
*
!backend/
!frontend/
backend/.venv
backend/tests
backend/**/__pycache__
backend/.pytest_cache
backend/.ruff_cache
backend/.env
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.env
frontend/**/*.test.ts
frontend/**/*.test.tsx
