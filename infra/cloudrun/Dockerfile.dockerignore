# Used by `docker build -f infra/cloudrun/Dockerfile .` (BuildKit reads <Dockerfile>.dockerignore).
# Allow-list: only what the production image needs.
*
!backend/
!frontend/
# F5 Assistant knowledge: the markdown docs only
!README.md
!AGENTS.md
!docs/**/*.md
backend/.venv
backend/tests
backend/conftest.py
backend/app/**/tests
backend/**/__pycache__
backend/.pytest_cache
backend/.ruff_cache
backend/.env
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.env
frontend/**/*.test.ts
frontend/**/*.test.tsx
